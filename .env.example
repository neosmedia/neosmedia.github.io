# The full site is live by default. Set to "false" to bring back the coming soon page at /
# (inner pages are then hidden from search engines and the sitemap).
NEXT_PUBLIC_LAUNCHED=true

# Contact form: create a form at https://formspree.io (set it to deliver to
# tylerlangebc@gmail.com) and paste the ID from its endpoint, e.g.
# https://formspree.io/f/abcdwxyz  ->  abcdwxyz
NEXT_PUBLIC_FORMSPREE_ID=

# "Book a time to chat" button (Cal.com, Calendly, ...). Falls back to email.
NEXT_PUBLIC_BOOKING_URL=
